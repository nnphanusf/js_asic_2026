; SPI controller (all four modes) and SPI target (mode 0).
;
; Default pins follow the Tiny Tapeout SPI Pmod convention on the bidirectional header:
;   CS = PIN11 (uio[0]), MOSI = PIN12 (uio[1]), MISO = PIN13 (uio[2]), SCK = PIN14 (uio[3]).
; Bytes travel MSB first, one per FIFO word, right aligned.

.define CPOL 0

.program spi_ctrl_cpha0
; Controller for CPHA = 0 (mode 0, or mode 2 with CPOL = 1).
; Host protocol: push N-1, then N bytes. The program lowers CS, exchanges N bytes, raises CS, and
; pushes every received byte to the RX FIFO. A bit takes 4 ticks: SCK = f_clk / (4 * clkdiv),
; at most f_clk / 8 (clkdiv 2: 6.25 MHz at 50 MHz) so that MISO has time to pass the input
; synchronizer (bitweaver.proto.spi_clkdiv).
.side_set 1
.pins out=12 out_count=1 set=11 set_count=1 side=14 in=13 dirs=11,12,14 high=11
.shift out=left in=left autopush=8
.init nop side CPOL
.wrap_target
    pull           side CPOL       ; header: number of bytes - 1
    mov x, osr     side CPOL
    set pins, 0    side CPOL       ; CS low
byte:
    pull           side CPOL
    mov osr, <>osr side CPOL       ; move the byte to the top of the OSR
    set y, 7       side CPOL
bit:
    out pins, 1    side CPOL [1]   ; data out half a bit before the leading edge
    in pins, 1     side 1-CPOL     ; leading edge: sample MISO
    jmp y-- bit    side 1-CPOL
    jmp x-- byte   side CPOL
    set pins, 1    side CPOL [1]   ; CS high
.wrap

.program spi_ctrl_cpha1
; Controller for CPHA = 1 (mode 1, or mode 3 with CPOL = 1). Same host protocol and speed as above.
.side_set 1
.pins out=12 out_count=1 set=11 set_count=1 side=14 in=13 dirs=11,12,14 high=11
.shift out=left in=left autopush=8
.init nop side CPOL
.wrap_target
    pull           side CPOL
    mov x, osr     side CPOL
    set pins, 0    side CPOL
byte:
    pull           side CPOL
    mov osr, <>osr side CPOL
    set y, 7       side CPOL
bit:
    out pins, 1    side 1-CPOL [1] ; leading edge: data out
    in pins, 1     side CPOL       ; trailing edge: sample MISO
    jmp y-- bit    side CPOL
    jmp x-- byte   side CPOL
    set pins, 1    side CPOL [1]
.wrap

.program spi_target
; Mode 0 target.
; * Every received byte goes to the RX FIFO. If the FIFO is full the byte is dropped and
;   FDEBUG.RXSTALL is set, because a target must never stall the bus.
; * Each reply byte comes from the TX FIFO, or is 0xFF if the FIFO is empty. The next reply is
;   fetched during the last bit of the previous byte, and while CS is high and no reply is waiting
;   the FIFO is checked every 6 cycles, so a reply queued between frames is not lost.
; * MISO is driven only while CS is low, so several targets can share it. The first bit is on the
;   (released) pin before CS falls, and MISO is driven 4 cycles after CS falls (up to 9 if the
;   reply arrived in the last few cycles before CS fell). The target
;   releases MISO a few cycles after CS rises, also in the middle of a byte; a byte cut short by CS
;   is dropped in both directions.
; Run at clkdiv 1. Limits at 50 MHz, at any phase (sw/tests/test_clock_and_host_timing.py): SCK up to
; 2.5 MHz with up to three cycles (60 ns) of pad and multiplexer delay on MISO, 3 MHz with up to two;
; CS low at least 160 ns before the first rising SCK edge (80 ns with ideal pads).
.pins in=12 out=13 out_count=1 set=13 set_count=1 jmp=11
.shift in=left out=left
.timeout 0                    ; a timed WAIT checks once and falls through
    mov x, !null              ; X = 0xFFFF marks "no reply": host bytes are at most 0xFF
abort:                        ; also the start: no reply in the OSR, nothing received
    mov osr, x                ; CS rose mid-byte: drop the partly sent reply
    mov isr, null             ; and the bits received so far
wait_cs:
    set pindirs, 0            ; deselected: release MISO
poll:
    mov y, osr
    jmp x!=y staged           ; a real reply is already waiting
    pull noblock              ; otherwise try the FIFO
    mov osr, <>osr            ; reply byte to the top of the OSR (0xFFFF stays 0xFFFF)
    mov pins, ::osr
    jmp pin poll              ; CS (JMP_PIN, PIN11) still high: keep looking for a reply
staged:
    mov pins, ::osr           ; the reply's MSB on the released pin, without shifting it out
hold:
    jmp pin hold              ; wait for CS low, checking every cycle
    set pindirs, 1            ; selected: drive MISO
.wrap_target
first:
    jmp pin wait_cs           ; CS released before the first clock edge
    wait 1 pin 2 timeout      ; SCK high skips the next instruction
    jmp first
    set y, 6
bit:
    in pins, 1                ; rising edge: sample MOSI
    out null, 1               ; drop the bit just sent
fall:
    jmp pin abort             ; CS released in the middle of a byte
    wait 0 pin 2 timeout      ; falling edge: show the next bit
    jmp fall
    mov pins, ::osr
rise:
    jmp pin abort
    wait 1 pin 2 timeout
    jmp rise
    jmp y-- bit
    in pins, 1                ; last bit
    push noblock
    pull noblock              ; fetch the next reply now
    mov osr, <>osr
last:
    jmp pin wait_cs           ; CS released after the last rising edge, even with SCK still high
    wait 0 pin 2 timeout      ; the last falling edge
    jmp last
    mov pins, ::osr           ; the next byte's MSB
.wrap
