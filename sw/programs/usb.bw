; Low-speed USB (1.5 Mbit/s) packet transmitter and receiver.
;
; A bit is 10 ticks: the divider is the clock / 15 MHz, so 40 clock cycles per bit at 60 MHz and a
; fractional 33.3 at 50 MHz (bit edges then move by up to one clock). usb_rx synchronizes on the first
; K of SYNC only, so the sender must be within about 0.4 % of 1.5 Mbit/s for an 8-byte DATA packet
; (crystal or PLL clocked); USB allows a low-speed device 1.5 %. The bit-level assist unit does
; NRZI coding and bit stuffing (a 0 after six 1s) in both directions, and computes the CRC16 of DATA
; packets on transmit. Line states for low speed: J = D- high, D+ low; K = D- low, D+ high; SE0 = both
; low. Pins: D- = PIN11 (uio[0]), D+ = PIN12 (uio[1]); the bus needs the usual 1.5 kOhm pull-up on D-.

.define DM 11

.program usb_tx
; A segment interpreter. The host queues segments (bitweaver.proto.usb_tx_words); each is two words,
; a bit count minus one and an instruction, followed by the segment's bits LSB first. The engine
; executes the instruction just before the segment's first bit, so the host decides per packet:
;   SYNC + PID       nop
;   payload          set bau, BAU_NRZI | BAU_STUFF | BAU_CRC   (the CRC16 covers only the payload)
;   CRC16            mov osr, !crc                              (no data words: the bits come from the CRC)
;   end of packet    jmp eop
; Inside every 10-tick bit the pins change at tick 3, also across segments and stuff bits.
; A packet starts with its first word and a late word stalls it on the wire, so queue each packet
; with push_packet (bitweaver.loader.Driver, the board driver, the testbench): it preloads the 8-word
; FIFO with the engine stopped. Handshakes (5 words), tokens (8) and empty DATA packets (7) then
; have no deadline; for longer DATA packets the rest must follow within the preloaded words' time on
; the wire, about 43 us for 8 bytes. The host port at SCK = clk/16 manages that; streaming the words
; as the FIFO drains does not, and neither does the bit-banged MicroPython port.
.pins out=DM out_count=2 set=DM set_count=2 jmp=STUFF
.clkdiv F_CLK / 15000000
.bau poly=0xA001 stuff=6 ones
.shift out=right
.fifo join_tx
.wrap_target
start:
    pull                      ; the first segment header: wait here, bus released, until a packet comes
    set pins, 1               ; J (D- high)
    set pindirs, 3            ; drive D- and D+
    mov crc, !null            ; CRC16 starts at 0xFFFF
    set bau, BAU_RESET | BAU_NRZI | BAU_STUFF
    jmp hdr
bits:
    jmp pin stuff             ; 0: virtual pin 21, a stuff bit is due
    pull ifempty              ; 1
    jmp !x last               ; 2
    out pins, bau [5]         ; 3..8: NRZI line state on D-, its complement on D+
    jmp x-- bits              ; 9
stuff:
    nop [1]                   ; 1..2
    out pins, bau [5]         ; 3..8
    jmp bits                  ; 9
last:
    out pins, bau             ; 3: last bit of the segment
next:
    pull                      ; 4: segment header, bit count - 1
hdr:
    out x, 16                 ; 5
    pull                      ; 6: the segment's instruction
    out exec, 16              ; 7: it runs at 8
    jmp bits                  ; 9
eop:                          ; reached at 9 through "jmp eop"
    jmp pin estuff [3]        ; 9..12: a pending stuff bit goes out before the EOP
eop2:
    set pins, 0 [19]          ; SE0 for two bit times
    set pins, 1 [9]           ; J for one bit time
    set pindirs, 0            ; release the bus
.wrap
estuff:
    out pins, bau [8]         ; 13..21
    jmp eop2                  ; 22

.program usb_rx
; Receives packets: destuffed, NRZI-decoded bits are pushed LSB first in 16-bit words. At the end of
; the packet (IRQ flag 6 from usb_se0) the partial last word and the bit count are pushed.
; bitweaver.proto.usb_rx_decode checks SYNC, PID and CRC. A bit-stuffing error marks the packet bad
; (count 0xFFFF): seven ones in a row anywhere (the BAU's sticky BERR flag), or a stuff bit that is
; missing before the EOP (USB 2.0 7.1.9).
.pins in=DM jmp=30            ; JMP PIN: IRQ flag 6 (virtual pin 30)
.clkdiv F_CLK / 15000000
.bau stuff=6 ones
.shift in=right autopush=16
.fifo join_rx
.timeout 0
idle:
    irq clear 6
    wait 1 pin 0              ; J: the bus is idle (D- is also low during the previous packet's SE0)
    wait 0 pin 0              ; the first K of SYNC: hard synchronization
    set bau, BAU_RESET | BAU_NRZI | BAU_STUFF
    mov x, !null              ; X counts bits down from 0xFFFF; sample in the middle of each bit
.wrap_target
bit:
    wait 1 pin STUFF-DM timeout  ; 0: a stuff bit is due: skip the counting instruction
    jmp x-- count             ; 1
    jmp stuff                 ; 1
count:
    in pins, bau [6]          ; 2..8: NRZI decode and destuff D-
    jmp pin done              ; 9: SE0 seen
.wrap
stuff:
    mov osr, pins             ; 2: D- and D+ in the same cycle, where the stuff bit should be
    in osr, bau               ; 3: D- through the BAU: the stuff bit, checked and dropped
    out y, 2
    jmp !y bad                ; 5: both lines low: SE0 instead of the stuff bit, the sender left it out
    nop [1]                   ; 6..7
    jmp pin done              ; 8
    jmp bit                   ; 9
done:
    push                      ; partial last word (left aligned)
    wait 0 pin BERR-DM timeout   ; seven ones in a row somewhere (a stuff error): the packet is bad
    jmp bad
    wait 1 pin STUFF-DM timeout  ; a stuff bit still due at the EOP ...
    jmp good
    mov osr, !x
    out y, 1                  ; ... is fine only with an odd count: the extra SE0 sample (see
    jmp y-- good              ;     usb_rx_decode) made the run, not the sender
bad:
    mov x, null               ; bit count 0xFFFF: usb_rx_decode rejects the packet
good:
    mov isr, !x
    push                      ; bit count
    jmp idle

.program usb_se0
; Raises IRQ flag 6 when both lines are low (SE0, the end of packet). Run at clkdiv 1.
; Both lines are sampled in the same cycle (IN PINS, 2): testing them one after the other would see a
; K-to-J transition between the two tests as a false SE0.
.pins in=DM
.shift in=right
.wrap_target
loop:
    mov isr, null
    in pins, 2                ; D- and D+ together, into ISR bits 15:14
    mov x, isr
    jmp !x se0
    jmp loop
se0:
    irq 6
    wait 1 pin 0              ; wait for J after the EOP
.wrap
